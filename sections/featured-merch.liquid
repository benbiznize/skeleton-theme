{% javascript %}
  class FeaturedMerch {
    constructor(element) {
      this.el = element;
      this.viewport = this.el.querySelector('.featured-merch__items[data-layout="carousel"]');
      this.prev = this.el.querySelector('.featured-merch__control--prev');
      this.next = this.el.querySelector('.featured-merch__control--next');
      this.modal = this.el.querySelector('dialog');
      this.body = this.modal?.querySelector('[data-modal-body]');
      this.handleNav();
      this.handleModal();
    }
    handleNav() {
      if (!this.viewport) return;
      const scrollAmount = () => this.viewport.clientWidth * 0.8;
      this.prev?.addEventListener('click', () => this.viewport.scrollBy({ left: -scrollAmount(), behavior: 'smooth' }));
      this.next?.addEventListener('click', () => this.viewport.scrollBy({ left: scrollAmount(), behavior: 'smooth' }));
    }
    handleModal() {
      if (!this.modal || !this.body) return;
      this.modal.addEventListener('close', () => {
        this.body.innerHTML = '';
      });
      this.el.addEventListener('click', (event) => {
        const trigger = event.target.closest('[data-open-modal]');
        if (trigger) {
          event.preventDefault();
          const template = trigger.nextElementSibling?.cloneNode(true);
          if (!template) return;
          template.removeAttribute('hidden');
          this.body.innerHTML = '';
          this.body.appendChild(template);
          if (typeof this.modal.showModal === 'function') {
            this.modal.showModal();
          } else {
            this.modal.setAttribute('open', 'open');
          }
        }
        if (event.target.closest('[data-modal-close]')) {
          if (typeof this.modal.close === 'function') {
            this.modal.close();
          } else {
            this.modal.removeAttribute('open');
            this.body.innerHTML = '';
          }
        }
      });
    }
  }

  document.querySelectorAll('.featured-merch').forEach((section) => {
    if (!section.dataset.initialized) {
      section.dataset.initialized = 'true';
      new FeaturedMerch(section);
    }
  });
{% endjavascript %}
